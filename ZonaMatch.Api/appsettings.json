{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "ZonaMatch.Api",
    "Audience": "ZonaMatch.Frontend",
    "ExpirationMinutes": 60
  },
  "Geocoding": {
    "Provider": "Osm",
    "AllowProviderOverride": false
  },
  "Nominatim": {
    "Timeout": "00:00:10",
    "UserAgent": "ZonaMatch/1.0"
  },
  "Photon": {
    "Timeout": "00:00:10"
  },
  "Motis": {
    "RoutingTimeout": "00:00:08",
    "PlanningTimeout": "00:00:15"
  },
  "Market": {
    "UsdArs": 1568.7
  },
  "RateLimits": {
    "Login": { "PermitLimit": 10, "Window": "00:01:00" },
    "Contact": { "PermitLimit": 5, "Window": "00:10:00" },
    "PasswordReset": { "PermitLimit": 5, "Window": "00:15:00" },
    "InvitationEmail": { "PermitLimit": 10, "Window": "01:00:00" },
    "GuestReport": { "PermitLimit": 3, "Window": "01:00:00" },
    "ImageUpload": { "PermitLimit": 20, "Window": "00:10:00" }
  },
  "Cache": {
    "ZoneProfiles": "06:00:00",
    "NominatimAddresses": "1.00:00:00",
    "MotisTravelTimes": "1.00:00:00",
    "MotisRoutePlans": "1.00:00:00",
    "PublicResponseSeconds": 3600
  },
  "PlaceSearch": {
    "Provider": "Nominatim",
    "AllowProviderOverride": false
  },
  "Storage": {
    "ContainerName": "imagenes",
    "PublicRead": false
  },
  "Contacto": {
    "Destinatario": "zonamatchtpi@gmail.com"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "zonamatchtpi@gmail.com",
    "From": "zonamatchtpi@gmail.com"
  }
}
