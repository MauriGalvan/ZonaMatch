{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=zonamatch_docker;Username=zonamatch;Password=zonamatch"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Admin": {
    "IngestionEndpointsEnabled": false
  },
  "Ingestion": {
    "BatchSize": 500,
    "DuplicateMaxDistanceMeters": 100,
    "ScopePartidoCodes": [
      "028", "035", "091", "260", "270", "274", "371", "408", "410", "412", "427", "434",
      "490", "515", "539", "560", "568", "658", "749", "756", "760", "805", "840", "861"
    ],
    "TerritorialSources": [
      {
        "DataSourceCode": "zm-comunas",
        "Type": "Comuna",
        "Table": "zm.comunas",
        "IdColumn": "key",
        "NameColumn": "nombre",
        "CodeColumn": "censo_codigo",
        "GeometryColumn": "geom"
      },
      {
        "DataSourceCode": "zm-partidos",
        "Type": "Partido",
        "Table": "zm.partidos",
        "IdColumn": "censo_codigo",
        "NameColumn": "nombre",
        "CodeColumn": "censo_codigo",
        "GeometryColumn": "geom",
        "PreferredRowCondition": "key NOT LIKE 'ISLAS %'"
      },
      {
        "DataSourceCode": "zm-radios",
        "Type": "CensusTract",
        "Table": "zm.radios",
        "IdColumn": "id",
        "NameColumn": "id",
        "CodeColumn": "id",
        "GeometryColumn": "geom",
        "ParentType": "Comuna",
        "ParentCodeColumn": "comuna",
        "Filter": "origen = 'caba'",
        "SourceDate": "2022-05-18"
      },
      {
        "DataSourceCode": "zm-radios",
        "Type": "CensusTract",
        "Table": "zm.radios",
        "IdColumn": "id",
        "NameColumn": "id",
        "CodeColumn": "id",
        "GeometryColumn": "geom",
        "ParentType": "Partido",
        "ParentCodeColumn": "depto",
        "Filter": "origen = 'pba'",
        "SourceDate": "2022-05-18"
      },
      {
        "DataSourceCode": "osm",
        "Type": "Barrio",
        "Table": "public.planet_osm_polygon",
        "IdColumn": "osm_id",
        "NameColumn": "name",
        "GeometryColumn": "way",
        "ParentType": "Comuna",
        "Filter": "boundary = 'administrative' AND admin_level = '10' AND name IS NOT NULL"
      },
      {
        "DataSourceCode": "osm",
        "Type": "Localidad",
        "Table": "public.planet_osm_polygon",
        "IdColumn": "osm_id",
        "NameColumn": "name",
        "GeometryColumn": "way",
        "ParentType": "Partido",
        "Filter": "boundary = 'administrative' AND admin_level = '8' AND name IS NOT NULL"
      }
    ],
    "PoiSources": [
      {
        "DataSourceCode": "zm-escuelas",
        "Table": "zm.escuelas",
        "IdColumn": "clave_natural",
        "NameColumn": "nombre",
        "GeometryColumn": "geom",
        "AttributeColumns": [ "nivel", "sector", "modalidad", "direccion", "localidad", "cue", "matricula" ],
        "AddressColumns": [ "direccion" ],
        "OwnershipAttribute": "sector",
        "PublicValues": [ "Estatal" ],
        "PrivateValues": [ "Privado" ],
        "Filter": "partido_key IN ('ALMIRANTE BROWN','AVELLANEDA','BERAZATEGUI','ESTEBAN ECHEVERRIA','EZEIZA','FLORENCIO VARELA','GENERAL SAN MARTIN','HURLINGHAM','ITUZAINGO','JOSE C. PAZ','LA MATANZA','LANUS','LOMAS DE ZAMORA','MALVINAS ARGENTINAS','MERLO','MORENO','MORON','QUILMES','SAN FERNANDO','SAN ISIDRO','SAN MIGUEL','TIGRE','TRES DE FEBRERO','VICENTE LOPEZ')",
        "SourceDate": "2026-03-01"
      },
      {
        "DataSourceCode": "osm",
        "Table": "public.planet_osm_point",
        "IdColumn": "osm_id",
        "IdPrefix": "n",
        "OsmIdentifiers": true,
        "NameColumn": "name",
        "GeometryColumn": "way",
        "AttributeColumns": [ "amenity", "shop", "leisure", "tourism", "railway", "highway", "sport", "operator" ],
        "TagsColumn": "tags",
        "AddressColumns": [ "addr:street", "addr:housenumber" ],
        "OwnershipAttribute": "operator:type",
        "PublicValues": [ "public", "government" ],
        "PrivateValues": [ "private" ],
        "Filter": "amenity IS NOT NULL OR shop IS NOT NULL OR leisure IS NOT NULL OR tourism IS NOT NULL OR railway IS NOT NULL OR highway = 'bus_stop'"
      },
      {
        "DataSourceCode": "osm",
        "Table": "public.planet_osm_polygon",
        "IdColumn": "osm_id",
        "IdPrefix": "w",
        "OsmIdentifiers": true,
        "NameColumn": "name",
        "GeometryColumn": "way",
        "AttributeColumns": [ "amenity", "shop", "leisure", "tourism", "railway", "sport", "operator" ],
        "TagsColumn": "tags",
        "AddressColumns": [ "addr:street", "addr:housenumber" ],
        "OwnershipAttribute": "operator:type",
        "PublicValues": [ "public", "government" ],
        "PrivateValues": [ "private" ],
        "Filter": "(amenity IS NOT NULL OR shop IS NOT NULL OR leisure IS NOT NULL OR tourism IS NOT NULL OR railway IS NOT NULL) AND boundary IS NULL"
      }
    ]
  }
}
